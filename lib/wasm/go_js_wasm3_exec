SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
	DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
	SOURCE="$(readlink "$SOURCE")"
	[[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"

exec node \
	--experimental-wasm-stack-switching --experimental-wasm-wasmfx \
	--stack-size=8192 \
	"$DIR/wasm_exec_wasm3.js" "$@"
