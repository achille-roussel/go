(Last ___) => v.Args[len(v.Args)-1]

// Lowering arithmetic
(Add(64|32|16|8|Ptr) ...) => (I64Add ...)
(Add(64|32)F ...) => (F(64|32)Add ...)

(Sub(64|32|16|8|Ptr) ...) => (I64Sub ...)
(Sub(64|32)F ...) => (F(64|32)Sub ...)

(Mul(64|32|16|8) ...) => (I64Mul ...)
(Mul(64|32)F ...) => (F(64|32)Mul ...)

(Div64 [false] x y) => (I64DivS x y)
(Div32 [false] x y) => (I64DivS (SignExt32to64 x) (SignExt32to64 y))
(Div16 [false] x y) => (I64DivS (SignExt16to64 x) (SignExt16to64 y))
(Div8          x y) => (I64DivS (SignExt8to64 x) (SignExt8to64 y))
(Div64u ...) => (I64DivU ...)
(Div32u x y) => (I64DivU (ZeroExt32to64 x) (ZeroExt32to64 y))
(Div16u x y) => (I64DivU (ZeroExt16to64 x) (ZeroExt16to64 y))
(Div8u  x y) => (I64DivU (ZeroExt8to64 x) (ZeroExt8to64 y))
(Div(64|32)F ...) => (F(64|32)Div ...)

(Mod64 [false] x y) => (I64RemS x y)
(Mod32 [false] x y) => (I64RemS (SignExt32to64 x) (SignExt32to64 y))
(Mod16 [false] x y) => (I64RemS (SignExt16to64 x) (SignExt16to64 y))
(Mod8          x y) => (I64RemS (SignExt8to64  x) (SignExt8to64  y))
(Mod64u ...) => (I64RemU ...)
(Mod32u x y) => (I64RemU (ZeroExt32to64 x) (ZeroExt32to64 y))
(Mod16u x y) => (I64RemU (ZeroExt16to64 x) (ZeroExt16to64 y))
(Mod8u  x y) => (I64RemU (ZeroExt8to64  x) (ZeroExt8to64  y))

(And(64|32|16|8|B) ...) => (I64And ...)

(Or(64|32|16|8|B) ...) => (I64Or ...)

(Xor(64|32|16|8) ...) => (I64Xor ...)

(Neg(64|32|16|8) x) => (I64Sub (I64Const [0]) x)
(Neg(64|32)F ...) => (F(64|32)Neg ...)

(Com(64|32|16|8) x) => (I64Xor x (I64Const [-1]))

(Not ...) => (I64Eqz ...)

(Avg64u x y) => (I64Add (I64ShrU (I64Sub x y) (I64Const [1])) y)

// High word of multiply without carry bits; see Hacker's Delight, 2nd. ed, Figure 8-2, p. 174.
(Hmul64 <t> x y) =>
	(Last <t>
		x0: (ZeroExt32to64 x)
		x1: (I64ShrS x (I64Const [32]))
		y0: (ZeroExt32to64 y)
		y1: (I64ShrS y (I64Const [32]))
		x0y0: (I64Mul x0 y0)
		tt: (I64Add (I64Mul x1 y0) (I64ShrU x0y0 (I64Const [32])))
		w1: (I64Add (I64Mul x0 y1) (ZeroExt32to64 tt))
		w2: (I64ShrS tt (I64Const [32]))
		(I64Add (I64Add (I64Mul x1 y1) w2) (I64ShrS w1 (I64Const [32]))))

// Same as Hmul64 but signed shifts now unsigned.
(Hmul64u <t> x y) =>
	(Last <t>
		x0: (ZeroExt32to64 x)
		x1: (I64ShrU x (I64Const [32]))
		y0: (ZeroExt32to64 y)
		y1: (I64ShrU y (I64Const [32]))
		w0: (I64Mul x0 y0)
		tt: (I64Add (I64Mul x1 y0) (I64ShrU w0 (I64Const [32])))
		w1: (I64Add (I64Mul x0 y1) (ZeroExt32to64 tt))
		w2: (I64ShrU tt (I64Const [32]))
		hi: (I64Add (I64Add (I64Mul x1 y1) w2) (I64ShrU w1 (I64Const [32]))))

(Select0 <t> (Mul64uhilo x y)) => (Hmul64u <t> x y)
(Select1 <t> (Mul64uhilo x y)) => (I64Mul x y)

// Lowering pointer arithmetic.
// A field address into a WasmGC struct (&s.f, where the base points at
// a struct) is NOT linear pointer arithmetic — there is no linear
// address to add to. Keep such OffPtrs symbolic so the field-access
// rules below can turn a Load/Store through them into struct.get/set
// (doc/wasm3-slice-boxing.md field-access ABI). All other OffPtrs lower
// to linear arithmetic as before.
(OffPtr <t> [off] base) && !(base.Type.IsPtr() && base.Type.Elem() != nil && base.Type.Elem().IsStruct()) => (I64AddConst [off] base)

// WasmGC struct field access: Load/Store through &struct.field => struct.get/set.
// FieldGet/FieldSet carry the Go struct type (aux) and the field byte
// offset (auxint, TypInt); codegen resolves the offset to a WasmGC
// field index. These must precede the generic linear Load/Store rules.
(Load <t> (OffPtr [off] base) mem) && base.Type.IsPtr() && base.Type.Elem() != nil && base.Type.Elem().IsStruct() =>
	(FieldGet <t> {base.Type.Elem()} [off] base mem)
(Store {t} (OffPtr [off] base) val mem) && base.Type.IsPtr() && base.Type.Elem() != nil && base.Type.Elem().IsStruct() =>
	(FieldSet {base.Type.Elem()} [off] base val mem)

// Boxed package-level variables (pointer-representation cutover): a
// global of a boxed (WasmGC-reference) type lives in a wasm ref-global,
// so a load/store of it through its symbol address becomes global.get /
// global.set rather than a linear-memory load/store. Must precede the
// generic linear Load/Store and the symIsRO const-fold.
(Load <t> (LoweredAddr {sym} [0] (SB)) _) && config.arch == "wasm3" && wasm3IsBoxedType(t) => (GlobalGet <t> {sym})
(Store {t} (LoweredAddr {sym} [0] (SB)) val mem) && config.arch == "wasm3" && wasm3IsBoxedType(t) => (GlobalSet {sym} val mem)

// Dereference of an i64-class interior pointer ($go.ptr.i64 accessor-pair
// fat pointer): a Load/Store through a *i64-scalar value that is NOT a
// &struct.field OffPtr — those fold to FieldGet/FieldSet above — i.e. a
// fat pointer received as a parameter or materialized by MakeFieldPtr,
// becomes a call_ref through the get/set accessor. See
// doc/wasm3-pointer-cutover.
// OpWasm3InteriorPtr is the *other* fat-pointer family (container ref +
// element index, $go.iptr.<class>); a Load/Store through it must reach
// the LoadInterior/StoreInterior rules below (matching I64Load/I64Store),
// so it is excluded here and falls through to the generic Load/Store
// lowering that produces those I64Load/I64Store nodes.
(Load <t> ptr mem) && config.arch == "wasm3" && ptr.Op != OpOffPtr && ptr.Op != OpWasm3InteriorPtr && wasm3IsScalarPtr(ptr.Type) => (PtrLoad ptr)
(Store {t} ptr val mem) && config.arch == "wasm3" && ptr.Op != OpOffPtr && ptr.Op != OpWasm3InteriorPtr && wasm3IsScalarPtr(ptr.Type) => (PtrStore ptr val mem)

// wasm3: a Go array is a single (ref (array T)) and *[N]T IS that ref, so
// dereferencing an array pointer is the identity — the loaded array value
// is the pointer's ref. (&struct.arrayField Loads fold to FieldGet above,
// which yields the field's array ref; this handles a direct *[N]T deref,
// e.g. the (*[N]T)(p) load in a generated array equality func.) Element
// access then uses array.get/array.set via interior pointers; whole-array
// value copy is handled by Move/Zero, not this load.
(Load <t> ptr mem) && config.arch == "wasm3" && ptr.Op != OpOffPtr && t.IsArray() => (Copy ptr)

// Lowering extension
// It is unnecessary to extend loads
(SignExt32to64        x:(I64Load32S _ _)) => x
(SignExt16to(64|32)   x:(I64Load16S _ _)) => x
(SignExt8to(64|32|16) x:(I64Load8S  _ _)) => x
(ZeroExt32to64        x:(I64Load32U _ _)) => x
(ZeroExt16to(64|32)   x:(I64Load16U _ _)) => x
(ZeroExt8to(64|32|16) x:(I64Load8U  _ _)) => x
(SignExt32to64        x) => (I64Extend32S x)
(SignExt8to(64|32|16) x) => (I64Extend8S x)
(SignExt16to(64|32)   x) => (I64Extend16S x)
(ZeroExt32to64        x) => (I64And x (I64Const [0xffffffff]))
(ZeroExt16to(64|32)   x) => (I64And x (I64Const [0xffff]))
(ZeroExt8to(64|32|16) x) => (I64And x (I64Const [0xff]))

(Slicemask x) => (I64ShrS (I64Sub (I64Const [0]) x) (I64Const [63]))

// Lowering truncation
// Because we ignore the high parts, truncates are just copies.
(Trunc64to(32|16|8) ...) => (Copy ...)
(Trunc32to(16|8)    ...) => (Copy ...)
(Trunc16to8         ...) => (Copy ...)

// Lowering float <=> int
(Cvt32to(64|32)F x) => (F(64|32)ConvertI64S (SignExt32to64 x))
(Cvt64to(64|32)F ...) => (F(64|32)ConvertI64S ...)
(Cvt32Uto(64|32)F x) => (F(64|32)ConvertI64U (ZeroExt32to64 x))
(Cvt64Uto(64|32)F ...) => (F(64|32)ConvertI64U ...)

(Cvt32Fto32 ...) => (I64TruncSatF32S ...)
(Cvt32Fto64 ...) => (I64TruncSatF32S ...)
(Cvt64Fto32 ...) => (I64TruncSatF64S ...)
(Cvt64Fto64 ...) => (I64TruncSatF64S ...)
(Cvt32Fto32U ...) => (I64TruncSatF32U ...)
(Cvt32Fto64U ...) => (I64TruncSatF32U ...)
(Cvt64Fto32U ...) => (I64TruncSatF64U ...)
(Cvt64Fto64U ...) => (I64TruncSatF64U ...)

(Cvt32Fto64F ...) => (F64PromoteF32 ...)
(Cvt64Fto32F ...) => (F32DemoteF64 ...)

(CvtBoolToUint8 ...) => (Copy ...)

(Round32F ...) => (Copy ...)
(Round64F ...) => (Copy ...)

// Lowering shifts
// Unsigned shifts need to return 0 if shift amount is >= width of shifted value.

(Lsh64x64 x y) && shiftIsBounded(v) => (I64Shl x y)
(Lsh64x64 x (I64Const [c])) && uint64(c) < 64 => (I64Shl x (I64Const [c]))
(Lsh64x64 x (I64Const [c])) && uint64(c) >= 64 => (I64Const [0])
(Lsh64x64 x y) => (Select (I64Shl x y) (I64Const [0]) (I64LtU y (I64Const [64])))
(Lsh64x(32|16|8) [c] x y) => (Lsh64x64 [c] x (ZeroExt(32|16|8)to64 y))

(Lsh32x64 ...) => (Lsh64x64 ...)
(Lsh32x(32|16|8) [c] x y) => (Lsh64x64 [c] x (ZeroExt(32|16|8)to64 y))

(Lsh16x64 ...) => (Lsh64x64 ...)
(Lsh16x(32|16|8) [c] x y) => (Lsh64x64 [c] x (ZeroExt(32|16|8)to64 y))

(Lsh8x64 ...) => (Lsh64x64 ...)
(Lsh8x(32|16|8) [c] x y) => (Lsh64x64 [c] x (ZeroExt(32|16|8)to64 y))

(Rsh64Ux64 x y) && shiftIsBounded(v) => (I64ShrU x y)
(Rsh64Ux64 x (I64Const [c])) && uint64(c) < 64 => (I64ShrU x (I64Const [c]))
(Rsh64Ux64 x (I64Const [c])) && uint64(c) >= 64 => (I64Const [0])
(Rsh64Ux64 x y) => (Select (I64ShrU x y) (I64Const [0]) (I64LtU y (I64Const [64])))
(Rsh64Ux(32|16|8) [c] x y) => (Rsh64Ux64 [c] x (ZeroExt(32|16|8)to64 y))

(Rsh32Ux64 [c] x y) => (Rsh64Ux64 [c] (ZeroExt32to64 x) y)
(Rsh32Ux(32|16|8) [c] x y) => (Rsh64Ux64 [c] (ZeroExt32to64 x) (ZeroExt(32|16|8)to64 y))

(Rsh16Ux64 [c] x y) => (Rsh64Ux64 [c] (ZeroExt16to64 x) y)
(Rsh16Ux(32|16|8) [c] x y) => (Rsh64Ux64 [c] (ZeroExt16to64 x) (ZeroExt(32|16|8)to64 y))

(Rsh8Ux64 [c] x y) => (Rsh64Ux64 [c] (ZeroExt8to64 x) y)
(Rsh8Ux(32|16|8) [c] x y) => (Rsh64Ux64 [c] (ZeroExt8to64 x) (ZeroExt(32|16|8)to64 y))

// Signed right shift needs to return 0/-1 if shift amount is >= width of shifted value.
// We implement this by setting the shift value to (width - 1) if the shift value is >= width.

(Rsh64x64 x y) && shiftIsBounded(v) => (I64ShrS x y)
(Rsh64x64 x (I64Const [c])) && uint64(c) < 64 => (I64ShrS x (I64Const [c]))
(Rsh64x64 x (I64Const [c])) && uint64(c) >= 64 => (I64ShrS x (I64Const [63]))
(Rsh64x64 x y) => (I64ShrS x (Select <typ.Int64> y (I64Const [63]) (I64LtU y (I64Const [64]))))
(Rsh64x(32|16|8) [c] x y) => (Rsh64x64 [c] x (ZeroExt(32|16|8)to64 y))

(Rsh32x64 [c] x y) => (Rsh64x64 [c] (SignExt32to64 x) y)
(Rsh32x(32|16|8) [c] x y) => (Rsh64x64 [c] (SignExt32to64 x) (ZeroExt(32|16|8)to64 y))

(Rsh16x64 [c] x y) => (Rsh64x64 [c] (SignExt16to64 x) y)
(Rsh16x(32|16|8) [c] x y) => (Rsh64x64 [c] (SignExt16to64 x) (ZeroExt(32|16|8)to64 y))

(Rsh8x64 [c] x y)  => (Rsh64x64 [c] (SignExt8to64 x) y)
(Rsh8x(32|16|8) [c] x y)  => (Rsh64x64 [c] (SignExt8to64 x) (ZeroExt(32|16|8)to64 y))

// Lowering rotates
(RotateLeft8 <t> x (I64Const [c])) => (Or8 (Lsh8x64 <t> x (I64Const [c&7])) (Rsh8Ux64 <t> x (I64Const [-c&7])))
(RotateLeft16 <t> x (I64Const [c])) => (Or16 (Lsh16x64 <t> x (I64Const [c&15])) (Rsh16Ux64 <t> x (I64Const [-c&15])))
(RotateLeft32 ...) => (I32Rotl ...)
(RotateLeft64 ...) => (I64Rotl ...)

// Lowering comparisons
(Less64  ...) => (I64LtS ...)
(Less32  x y) => (I64LtS (SignExt32to64 x) (SignExt32to64 y))
(Less16  x y) => (I64LtS (SignExt16to64 x) (SignExt16to64 y))
(Less8   x y) => (I64LtS (SignExt8to64  x) (SignExt8to64  y))
(Less64U ...) => (I64LtU ...)
(Less32U x y) => (I64LtU (ZeroExt32to64 x) (ZeroExt32to64 y))
(Less16U x y) => (I64LtU (ZeroExt16to64 x) (ZeroExt16to64 y))
(Less8U  x y) => (I64LtU (ZeroExt8to64  x) (ZeroExt8to64  y))
(Less(64|32)F ...) => (F(64|32)Lt ...)

(Leq64  ...) => (I64LeS ...)
(Leq32  x y) => (I64LeS (SignExt32to64 x) (SignExt32to64 y))
(Leq16  x y) => (I64LeS (SignExt16to64 x) (SignExt16to64 y))
(Leq8   x y) => (I64LeS (SignExt8to64  x) (SignExt8to64  y))
(Leq64U ...) => (I64LeU ...)
(Leq32U x y) => (I64LeU (ZeroExt32to64 x) (ZeroExt32to64 y))
(Leq16U x y) => (I64LeU (ZeroExt16to64 x) (ZeroExt16to64 y))
(Leq8U  x y) => (I64LeU (ZeroExt8to64  x) (ZeroExt8to64  y))
(Leq(64|32)F ...) => (F(64|32)Le ...)

(Eq64  ...) => (I64Eq ...)
(Eq32  x y) => (I64Eq (ZeroExt32to64 x) (ZeroExt32to64 y))
(Eq16  x y) => (I64Eq (ZeroExt16to64 x) (ZeroExt16to64 y))
(Eq8   x y) => (I64Eq (ZeroExt8to64  x) (ZeroExt8to64  y))
(EqB   ...) => (I64Eq ...)
(EqPtr ...) => (I64Eq ...)
(Eq(64|32)F ...) => (F(64|32)Eq ...)

(Neq64  ...) => (I64Ne ...)
(Neq32  x y) => (I64Ne (ZeroExt32to64 x) (ZeroExt32to64 y))
(Neq16  x y) => (I64Ne (ZeroExt16to64 x) (ZeroExt16to64 y))
(Neq8   x y) => (I64Ne (ZeroExt8to64  x) (ZeroExt8to64  y))
(NeqB   ...) => (I64Ne ...)
(NeqPtr ...) => (I64Ne ...)
(Neq(64|32)F ...) => (F(64|32)Ne ...)

// Lowering loads
(Load <t> ptr mem) && is32BitFloat(t) => (F32Load ptr mem)
(Load <t> ptr mem) && is64BitFloat(t) => (F64Load ptr mem)
(Load <t> ptr mem) && t.Size() == 8 => (I64Load ptr mem)
(Load <t> ptr mem) && t.Size() == 4 && !t.IsSigned() => (I64Load32U ptr mem)
(Load <t> ptr mem) && t.Size() == 4 &&  t.IsSigned() => (I64Load32S ptr mem)
(Load <t> ptr mem) && t.Size() == 2 && !t.IsSigned() => (I64Load16U ptr mem)
(Load <t> ptr mem) && t.Size() == 2 &&  t.IsSigned() => (I64Load16S ptr mem)
(Load <t> ptr mem) && t.Size() == 1 && !t.IsSigned() => (I64Load8U ptr mem)
(Load <t> ptr mem) && t.Size() == 1 &&  t.IsSigned() => (I64Load8S ptr mem)

// Lowering stores
(Store {t} ptr val mem) && is64BitFloat(t) => (F64Store ptr val mem)
(Store {t} ptr val mem) && is32BitFloat(t) => (F32Store ptr val mem)
(Store {t} ptr val mem) && t.Size() == 8 => (I64Store ptr val mem)
(Store {t} ptr val mem) && t.Size() == 4 => (I64Store32 ptr val mem)
(Store {t} ptr val mem) && t.Size() == 2 => (I64Store16 ptr val mem)
(Store {t} ptr val mem) && t.Size() == 1 => (I64Store8 ptr val mem)

// Lowering moves
(Move [0] _ _ mem) => mem
(Move [1] dst src mem) => (I64Store8 dst (I64Load8U src mem) mem)
(Move [2] dst src mem) => (I64Store16 dst (I64Load16U src mem) mem)
(Move [4] dst src mem) => (I64Store32 dst (I64Load32U src mem) mem)
(Move [8] dst src mem) => (I64Store dst (I64Load src mem) mem)
(Move [16] dst src mem) =>
	(I64Store [8] dst (I64Load [8] src mem)
		(I64Store dst (I64Load src mem) mem))
(Move [3] dst src mem) =>
	(I64Store8 [2] dst (I64Load8U [2] src mem)
		(I64Store16 dst (I64Load16U src mem) mem))
(Move [5] dst src mem) =>
	(I64Store8 [4] dst (I64Load8U [4] src mem)
		(I64Store32 dst (I64Load32U src mem) mem))
(Move [6] dst src mem) =>
	(I64Store16 [4] dst (I64Load16U [4] src mem)
		(I64Store32 dst (I64Load32U src mem) mem))
(Move [7] dst src mem) =>
	(I64Store32 [3] dst (I64Load32U [3] src mem)
		(I64Store32 dst (I64Load32U src mem) mem))
(Move [s] dst src mem) && s > 8 && s < 16 =>
	(I64Store [s-8] dst (I64Load [s-8] src mem)
		(I64Store dst (I64Load src mem) mem))

// Large copying uses helper.
(Move [s] dst src mem) && logLargeCopy(v, s) =>
	(LoweredMove [s] dst src mem)

// Lowering Zero instructions
// A wasmgc stack array is zero-initialized by array.new_default already,
// so the SSA-level zeroing pattern that ssagen emits at variable
// declaration is redundant. Match it before the per-size Zero rules
// below so we don't expand into linear-memory I64Stores against a
// (ref (array T)) destination.
(Zero [_] (StackArray _) mem) => mem

(Zero [0] _ mem) => mem
(Zero [1] destptr mem) => (I64Store8 destptr (I64Const [0]) mem)
(Zero [2] destptr mem) => (I64Store16 destptr (I64Const [0]) mem)
(Zero [4] destptr mem) => (I64Store32 destptr (I64Const [0]) mem)
(Zero [8] destptr mem) => (I64Store destptr (I64Const [0]) mem)

(Zero [3] destptr mem) =>
	(I64Store8 [2] destptr (I64Const [0])
		(I64Store16 destptr (I64Const [0]) mem))
(Zero [5] destptr mem) =>
	(I64Store8 [4] destptr (I64Const [0])
		(I64Store32 destptr (I64Const [0]) mem))
(Zero [6] destptr mem) =>
	(I64Store16 [4] destptr (I64Const [0])
		(I64Store32 destptr (I64Const [0]) mem))
(Zero [7] destptr mem) =>
	(I64Store32 [3] destptr (I64Const [0])
		(I64Store32 destptr (I64Const [0]) mem))

// Strip off any fractional word zeroing.
(Zero [s] destptr mem) && s%8 != 0 && s > 8 && s < 32 =>
	(Zero [s-s%8] (OffPtr <destptr.Type> destptr [s%8])
		(I64Store destptr (I64Const [0]) mem))

// Zero small numbers of words directly.
(Zero [16] destptr mem) =>
	(I64Store [8] destptr (I64Const [0])
		(I64Store destptr (I64Const [0]) mem))
(Zero [24] destptr mem) =>
	(I64Store [16] destptr (I64Const [0])
		(I64Store [8] destptr (I64Const [0])
			(I64Store destptr (I64Const [0]) mem)))
(Zero [32] destptr mem) =>
	(I64Store [24] destptr (I64Const [0])
		(I64Store [16] destptr (I64Const [0])
			(I64Store [8] destptr (I64Const [0])
				(I64Store destptr (I64Const [0]) mem))))

// Large zeroing uses helper.
(Zero [s] destptr mem) =>
	(LoweredZero [s] destptr mem)

// Lowering constants
(Const64 ...) => (I64Const ...)
(Const(32|16|8) [c]) => (I64Const [int64(c)])
(Const(64|32)F ...) => (F(64|32)Const ...)
// Pointer-representation cutover: a nil *struct is a null WasmGC
// reference (ref.null), not a linear i64 0, so it lands in the anyref
// local wasm3ValueType assigns to *struct values. Other pointer kinds
// still use i64 0 until they are migrated. This must precede the generic
// ConstNil rule below.
(ConstNil <t>) && config.arch == "wasm3" && t.IsPtr() && t.Elem() != nil && t.Elem().IsStruct() => (RefNull <t> {t.Elem()})
(ConstNil) => (I64Const [0])
(ConstBool [c]) => (I64Const [b2i(c)])

// Lowering calls
(StaticCall ...) => (LoweredStaticCall ...)
(ClosureCall ...) => (LoweredClosureCall ...)
(InterCall ...) => (LoweredInterCall ...)
(TailCall ...) => (LoweredTailCall ...)
(TailCallInter ...) => (LoweredTailCallInter ...)

// Miscellaneous
(Convert ...) => (LoweredConvert ...)
(IsNonNil p) => (I64Eqz (I64Eqz p))
(IsInBounds ...) => (I64LtU ...)
(IsSliceInBounds ...) => (I64LeU ...)
// M3 Stage E phase 4 (wasm3): forward NilCheck through wasmgc-
// backed values. Refs produced by array.new_default / struct.new_-
// default are guaranteed non-null by the wasmgc allocator — the
// runtime panic path is unreachable. Replacing the NilCheck with
// its underlying ptr lets the Stage D/E load/store rules
// pattern-match the StackArray / MakeSlice / SubSlice base
// directly, instead of needing NilCheck-aware variants of every
// load/store rule. The check itself is dropped; downstream
// dead-store-elim cleans it up.
(NilCheck sa:(StackArray _) _) => sa
(NilCheck mk:(MakeSlice _ _ _) _) => mk
(NilCheck ss:(SubSlice _ _ _ _ _) _) => ss
(NilCheck iptr:(InteriorPtr _ _) _) => iptr

(NilCheck p mem) => (LoweredNilCheck p mem)
(GetClosurePtr ...) => (LoweredGetClosurePtr ...)
(GetCallerPC ...) => (LoweredGetCallerPC ...)
(GetCallerSP ...) => (LoweredGetCallerSP ...)
(Addr {sym} base) => (LoweredAddr {sym} [0] base)
(LocalAddr <t> {sym} base mem) && t.Elem().HasPointers() => (LoweredAddr {sym} (SPanchored base mem))
(LocalAddr <t> {sym} base _)  && !t.Elem().HasPointers() => (LoweredAddr {sym} base)

// Write barrier.
(WB ...) => (LoweredWB ...)

// --- Intrinsics ---
(Sqrt ...) => (F64Sqrt ...)
(Trunc ...) => (F64Trunc ...)
(Ceil ...) => (F64Ceil ...)
(Floor ...) => (F64Floor ...)
(RoundToEven ...) => (F64Nearest ...)
(Abs ...) => (F64Abs ...)
(Copysign ...) => (F64Copysign ...)

(F32DemoteF64 (F64(Sqrt|Trunc|Ceil|Floor|Nearest|Abs) (F64PromoteF32 x))) => (F32(Sqrt|Trunc|Ceil|Floor|Nearest|Abs) x)
(F32DemoteF64 (F64Copysign (F64PromoteF32 x) (F64PromoteF32 y))) => (F32Copysign x y)

(Sqrt32 ...) => (F32Sqrt ...)

(Ctz64 ...) => (I64Ctz ...)
(Ctz32 x) => (I64Ctz (I64Or x (I64Const [0x100000000])))
(Ctz16 x) => (I64Ctz (I64Or x (I64Const [0x10000])))
(Ctz8  x) => (I64Ctz (I64Or x (I64Const [0x100])))

(Ctz(64|32|16|8)NonZero ...) => (I64Ctz ...)

(BitLen64 x) => (I64Sub (I64Const [64]) (I64Clz x))
(BitLen(32|16|8) x) => (BitLen64 (ZeroExt(32|16|8)to64 x))

(PopCount64 ...) => (I64Popcnt ...)
(PopCount32 x) => (I64Popcnt (ZeroExt32to64 x))
(PopCount16 x) => (I64Popcnt (ZeroExt16to64 x))
(PopCount8  x) => (I64Popcnt (ZeroExt8to64  x))

(CondSelect ...) => (Select ...)

// --- Optimizations ---
(I64Add (I64Const [x]) (I64Const [y])) => (I64Const [x + y])
(I64Sub (I64Const [x]) (I64Const [y])) => (I64Const [x - y])
(I64Mul (I64Const [x]) (I64Const [y])) => (I64Const [x * y])
(I64And (I64Const [x]) (I64Const [y])) => (I64Const [x & y])
(I64Or  (I64Const [x]) (I64Const [y])) => (I64Const [x | y])
(I64Xor (I64Const [x]) (I64Const [y])) => (I64Const [x ^ y])
(F64Add (F64Const [x]) (F64Const [y])) => (F64Const [x + y])
(F64Mul (F64Const [x]) (F64Const [y])) && !math.IsNaN(x * y) => (F64Const [x * y])
(I64Eq  (I64Const [x]) (I64Const [y])) && x == y => (I64Const [1])
(I64Eq  (I64Const [x]) (I64Const [y])) && x != y => (I64Const [0])
(I64Ne  (I64Const [x]) (I64Const [y])) && x == y => (I64Const [0])
(I64Ne  (I64Const [x]) (I64Const [y])) && x != y => (I64Const [1])

(I64Shl (I64Const [x]) (I64Const [y])) => (I64Const [x << uint64(y)])
(I64ShrU (I64Const [x]) (I64Const [y])) => (I64Const [int64(uint64(x) >> uint64(y))])
(I64ShrS (I64Const [x]) (I64Const [y])) => (I64Const [x >> uint64(y)])

// Identity and absorption rules for AND/OR/XOR/MUL.
// These fire on nodes created during or after lowering.
(I64And x (I64Const [-1])) => x
(I64And x (I64Const [0])) => (I64Const [0])
(I64Or  x (I64Const [0])) => x
(I64Or  x (I64Const [-1])) => (I64Const [-1])
(I64Xor x (I64Const [0])) => x
(I64Mul x (I64Const [0])) => (I64Const [0])
(I64Mul x (I64Const [1])) => x

// Double-mask elimination: cascaded zero-extensions produce
// (I64And (I64And x C1) C2) which can be collapsed to a single mask.
(I64And (I64And x (I64Const [c1])) (I64Const [c2])) => (I64And x (I64Const [c1 & c2]))

// Redundant sign-extensions: idempotent and narrower-subsumes-wider.
(I64Extend32S (I64Extend32S x)) => (I64Extend32S x)
(I64Extend16S (I64Extend16S x)) => (I64Extend16S x)
(I64Extend8S  (I64Extend8S  x)) => (I64Extend8S  x)
(I64Extend32S (I64Extend16S x)) => (I64Extend16S x)
(I64Extend32S (I64Extend8S  x)) => (I64Extend8S  x)
(I64Extend16S (I64Extend8S  x)) => (I64Extend8S  x)

// Sign-extend of a value already zero-extended from fewer bits is a no-op.
// E.g. (I64Extend32S (I64And x (I64Const [0xff]))) — top 33 bits are already
// zero, so sign-extending from 32 is identity.
(I64Extend32S x:(I64And _ (I64Const [c]))) && c >= 0 && int64(int32(c)) == c => x
(I64Extend16S x:(I64And _ (I64Const [c]))) && c >= 0 && int64(int16(c)) == c => x
(I64Extend8S  x:(I64And _ (I64Const [c]))) && c >= 0 && int64(int8(c))  == c => x

// TODO: declare these operations as commutative and get rid of these rules?
(I64Add (I64Const [x]) y) && y.Op != OpWasmI64Const => (I64Add y (I64Const [x]))
(I64Mul (I64Const [x]) y) && y.Op != OpWasmI64Const => (I64Mul y (I64Const [x]))
(I64And (I64Const [x]) y) && y.Op != OpWasmI64Const => (I64And y (I64Const [x]))
(I64Or  (I64Const [x]) y) && y.Op != OpWasmI64Const => (I64Or  y (I64Const [x]))
(I64Xor (I64Const [x]) y) && y.Op != OpWasmI64Const => (I64Xor y (I64Const [x]))
(F64Add (F64Const [x]) y) && y.Op != OpWasmF64Const => (F64Add y (F64Const [x]))
(F64Mul (F64Const [x]) y) && y.Op != OpWasmF64Const => (F64Mul y (F64Const [x]))
(I64Eq  (I64Const [x]) y) && y.Op != OpWasmI64Const => (I64Eq y  (I64Const [x]))
(I64Ne  (I64Const [x]) y) && y.Op != OpWasmI64Const => (I64Ne y  (I64Const [x]))

(I64Eq x (I64Const [0])) => (I64Eqz x)
(I64LtU (I64Const [0]) x) => (I64Eqz (I64Eqz x))
(I64LeU x (I64Const [0])) => (I64Eqz x)
(I64LtU x (I64Const [1])) => (I64Eqz x)
(I64LeU (I64Const [1]) x) => (I64Eqz (I64Eqz x))
(I64Ne x (I64Const [0])) => (I64Eqz (I64Eqz x))

(I64Add x (I64Const <t> [y])) && !t.IsPtr() => (I64AddConst [y] x)
(I64AddConst [0] x) => x
(I64Eqz (I64Eqz (I64Eqz x))) => (I64Eqz x)

// folding offset into load/store
((I64Load|I64Load32U|I64Load32S|I64Load16U|I64Load16S|I64Load8U|I64Load8S) [off] (I64AddConst [off2] ptr) mem)
	&& isU32Bit(off+off2) =>
	((I64Load|I64Load32U|I64Load32S|I64Load16U|I64Load16S|I64Load8U|I64Load8S) [off+off2] ptr mem)

((I64Store|I64Store32|I64Store16|I64Store8) [off] (I64AddConst [off2] ptr) val mem)
	&& isU32Bit(off+off2) =>
	((I64Store|I64Store32|I64Store16|I64Store8) [off+off2] ptr val mem)

// folding offset into address
(I64AddConst [off] (LoweredAddr {sym} [off2] base)) && isU32Bit(off+int64(off2)) =>
	(LoweredAddr {sym} [int32(off)+off2] base)
(I64AddConst [off] x:(SP)) && isU32Bit(off) => (LoweredAddr [int32(off)] x) // so it is rematerializeable

// M3 Stage D: stack-allocated array access lowered to array.get / array.set.
// The StackArray address holds a wasmgc `(ref (array T))`; element
// access uses the index computed from the byte offset and the element
// size. Two shapes per access:
//   - constant offset 0: index 0
//   - variable offset `i * elemSize`: index `i`
// (Larger composite offsets where the array is embedded in a struct are
// handled by Stage C's struct-field rules — not yet landed.)

// Constant-offset stores (index = off / elemSize).
(I64Store [off] sa:(StackArray <t> _) val mem) && t.Elem().Elem().Size() == 8 =>
	(ArraySet {t.Elem()} sa (I64Const <typ.Int> [off/8]) val mem)
(I64Store32 [off] sa:(StackArray <t> _) val mem) && t.Elem().Elem().Size() == 4 =>
	(ArraySet {t.Elem()} sa (I64Const <typ.Int> [off/4]) val mem)
(I64Store16 [off] sa:(StackArray <t> _) val mem) && t.Elem().Elem().Size() == 2 =>
	(ArraySet {t.Elem()} sa (I64Const <typ.Int> [off/2]) val mem)
(I64Store8 [off] sa:(StackArray <t> _) val mem) && t.Elem().Elem().Size() == 1 =>
	(ArraySet {t.Elem()} sa (I64Const <typ.Int> [off]) val mem)

// Variable-offset stores: `&buf + i * elemSize` lowered to `array.set ref i val`.
(I64Store [off] (I64Add sa:(StackArray <t> _) (I64Shl idx (I64Const [k]))) val mem)
	&& off == 0 && t.Elem().Elem().Size() == 8 && k == 3 =>
	(ArraySet {t.Elem()} sa idx val mem)
(I64Store32 [off] (I64Add sa:(StackArray <t> _) (I64Shl idx (I64Const [k]))) val mem)
	&& off == 0 && t.Elem().Elem().Size() == 4 && k == 2 =>
	(ArraySet {t.Elem()} sa idx val mem)
(I64Store16 [off] (I64Add sa:(StackArray <t> _) (I64Shl idx (I64Const [k]))) val mem)
	&& off == 0 && t.Elem().Elem().Size() == 2 && k == 1 =>
	(ArraySet {t.Elem()} sa idx val mem)
(I64Store8 [off] (I64Add sa:(StackArray <t> _) idx) val mem)
	&& off == 0 && t.Elem().Elem().Size() == 1 =>
	(ArraySet {t.Elem()} sa idx val mem)

// Constant-offset loads.
//
// The result type passed to ArrayGet drives the wasm3 codegen's
// signedness choice: signed Go integer types → array.get_s / sign-
// extend; unsigned → array.get_u / zero-extend. For non-packed elem
// sizes (4, 8) the wasmgc spec uses plain array.get; the codegen
// extends i32 → i64 according to v.Type.IsSigned() so a Load32U
// stays zero-extended and a Load32S stays sign-extended.
(I64Load [off] sa:(StackArray <t> _) mem) && t.Elem().Elem().Size() == 8 =>
	(ArrayGet <typ.Int64> {t.Elem()} sa (I64Const <typ.Int> [off/8]) mem)
(I64Load32S [off] sa:(StackArray <t> _) mem) && t.Elem().Elem().Size() == 4 =>
	(ArrayGet <typ.Int32> {t.Elem()} sa (I64Const <typ.Int> [off/4]) mem)
(I64Load32U [off] sa:(StackArray <t> _) mem) && t.Elem().Elem().Size() == 4 =>
	(ArrayGet <typ.UInt32> {t.Elem()} sa (I64Const <typ.Int> [off/4]) mem)
(I64Load16S [off] sa:(StackArray <t> _) mem) && t.Elem().Elem().Size() == 2 =>
	(ArrayGet <typ.Int16> {t.Elem()} sa (I64Const <typ.Int> [off/2]) mem)
(I64Load16U [off] sa:(StackArray <t> _) mem) && t.Elem().Elem().Size() == 2 =>
	(ArrayGet <typ.UInt16> {t.Elem()} sa (I64Const <typ.Int> [off/2]) mem)
(I64Load8S [off] sa:(StackArray <t> _) mem) && t.Elem().Elem().Size() == 1 =>
	(ArrayGet <typ.Int8> {t.Elem()} sa (I64Const <typ.Int> [off]) mem)
(I64Load8U [off] sa:(StackArray <t> _) mem) && t.Elem().Elem().Size() == 1 =>
	(ArrayGet <typ.UInt8> {t.Elem()} sa (I64Const <typ.Int> [off]) mem)

// Variable-offset loads (mirror of variable-offset stores). Same
// signed/unsigned-typed result-as-codegen-hint convention as the
// constant-offset rules above.
(I64Load [off] (I64Add sa:(StackArray <t> _) (I64Shl idx (I64Const [k]))) mem)
	&& off == 0 && t.Elem().Elem().Size() == 8 && k == 3 =>
	(ArrayGet <typ.Int64> {t.Elem()} sa idx mem)
(I64Load32S [off] (I64Add sa:(StackArray <t> _) (I64Shl idx (I64Const [k]))) mem)
	&& off == 0 && t.Elem().Elem().Size() == 4 && k == 2 =>
	(ArrayGet <typ.Int32> {t.Elem()} sa idx mem)
(I64Load32U [off] (I64Add sa:(StackArray <t> _) (I64Shl idx (I64Const [k]))) mem)
	&& off == 0 && t.Elem().Elem().Size() == 4 && k == 2 =>
	(ArrayGet <typ.UInt32> {t.Elem()} sa idx mem)
(I64Load16S [off] (I64Add sa:(StackArray <t> _) (I64Shl idx (I64Const [k]))) mem)
	&& off == 0 && t.Elem().Elem().Size() == 2 && k == 1 =>
	(ArrayGet <typ.Int16> {t.Elem()} sa idx mem)
(I64Load16U [off] (I64Add sa:(StackArray <t> _) (I64Shl idx (I64Const [k]))) mem)
	&& off == 0 && t.Elem().Elem().Size() == 2 && k == 1 =>
	(ArrayGet <typ.UInt16> {t.Elem()} sa idx mem)
(I64Load8S [off] (I64Add sa:(StackArray <t> _) idx) mem)
	&& off == 0 && t.Elem().Elem().Size() == 1 =>
	(ArrayGet <typ.Int8> {t.Elem()} sa idx mem)
(I64Load8U [off] (I64Add sa:(StackArray <t> _) idx) mem)
	&& off == 0 && t.Elem().Elem().Size() == 1 =>
	(ArrayGet <typ.UInt8> {t.Elem()} sa idx mem)

// Boxed slice header (doc/wasm3-slice-boxing.md): a slice is a single
// (ref $go.slice.<T>) struct with fields 0=data (ref $go.array.T),
// 1=off, 2=len, 3=cap (off/len/cap i64). Lower the generic slice
// component ops to StructNew/StructGet on the header. The Aux carries
// the slice *types.Type, which wasm3RegisterStructAux resolves to the
// header type via wasm3RegisterSliceStruct. off=0 for SliceMake (make
// and full slices; SubSlice carries its own offset). The dec.rules
// folds (SlicePtr(SliceMake)=>ptr etc.) are gated off for wasm3 so
// these survive decomposition and reach this lowering.
(SliceMake <t> ptr len cap) => (StructNew <t> {t} ptr (I64Const <typ.Int64> [0]) len cap)
(SlicePtr <t> s) => (SliceData <t> {s.Type} s)
(SlicePtrUnchecked <t> s) => (SliceData <t> {s.Type} s)
(SliceLen <t> s) => (SliceLength <t> {s.Type} s)
(SliceCap <t> s) => (SliceCapacity <t> {s.Type} s)

// Boxed string ($go.string = {backing, off, len}): StringMake builds the
// header (off=0; substrings carry their own offset), StringPtr/StringLen
// read fields 0/2. Like slices (doc/wasm3-slice-boxing.md).
(StringMake <t> ptr len) => (StructNew <t> {t} ptr (I64Const <typ.Int64> [0]) len)
(StringPtr <t> s) => (StringData <t> s)
(StringLen <t> s) => (StringLength <t> s)

// M3 Stage E phase 2: ref-backed slice element access lowered to
// array.get / array.set on the wasmgc backing.
//
// The data pointer of a wasm3-make slice traces back to a
// MakeSlice op (after the generic decomposition rule
// SlicePtr(SliceMake p _ _) => p). MakeSlice's v.Aux is the
// slice's *types.Type; t.Elem() is the element type whose size
// drives the wasmgc opcode width. The output op's Aux is set to
// the same slice type, matching what wasm3RegisterArrayAux
// expects (it derives the backing key from t.Elem()).

// Constant-offset stores (index = off / elemSize).
(I64Store [off] sm:(MakeSlice {t} _ _ _) val mem) && t.Elem().Size() == 8 =>
	(ArraySet {t} sm (I64Const <typ.Int> [off/8]) val mem)
(I64Store32 [off] sm:(MakeSlice {t} _ _ _) val mem) && t.Elem().Size() == 4 =>
	(ArraySet {t} sm (I64Const <typ.Int> [off/4]) val mem)
(I64Store16 [off] sm:(MakeSlice {t} _ _ _) val mem) && t.Elem().Size() == 2 =>
	(ArraySet {t} sm (I64Const <typ.Int> [off/2]) val mem)
(I64Store8 [off] sm:(MakeSlice {t} _ _ _) val mem) && t.Elem().Size() == 1 =>
	(ArraySet {t} sm (I64Const <typ.Int> [off]) val mem)

// Variable-offset stores: `&backing + i * elemSize` lowered to `array.set ref i val`.
(I64Store [off] (I64Add sm:(MakeSlice {t} _ _ _) (I64Shl idx (I64Const [k]))) val mem)
	&& off == 0 && t.Elem().Size() == 8 && k == 3 =>
	(ArraySet {t} sm idx val mem)
(I64Store32 [off] (I64Add sm:(MakeSlice {t} _ _ _) (I64Shl idx (I64Const [k]))) val mem)
	&& off == 0 && t.Elem().Size() == 4 && k == 2 =>
	(ArraySet {t} sm idx val mem)
(I64Store16 [off] (I64Add sm:(MakeSlice {t} _ _ _) (I64Shl idx (I64Const [k]))) val mem)
	&& off == 0 && t.Elem().Size() == 2 && k == 1 =>
	(ArraySet {t} sm idx val mem)
(I64Store8 [off] (I64Add sm:(MakeSlice {t} _ _ _) idx) val mem)
	&& off == 0 && t.Elem().Size() == 1 =>
	(ArraySet {t} sm idx val mem)

// Constant-offset loads.
(I64Load [off] sm:(MakeSlice {t} _ _ _) mem) && t.Elem().Size() == 8 =>
	(ArrayGet <typ.Int64> {t} sm (I64Const <typ.Int> [off/8]) mem)
(I64Load32S [off] sm:(MakeSlice {t} _ _ _) mem) && t.Elem().Size() == 4 =>
	(ArrayGet <typ.Int32> {t} sm (I64Const <typ.Int> [off/4]) mem)
(I64Load32U [off] sm:(MakeSlice {t} _ _ _) mem) && t.Elem().Size() == 4 =>
	(ArrayGet <typ.UInt32> {t} sm (I64Const <typ.Int> [off/4]) mem)
(I64Load16S [off] sm:(MakeSlice {t} _ _ _) mem) && t.Elem().Size() == 2 =>
	(ArrayGet <typ.Int16> {t} sm (I64Const <typ.Int> [off/2]) mem)
(I64Load16U [off] sm:(MakeSlice {t} _ _ _) mem) && t.Elem().Size() == 2 =>
	(ArrayGet <typ.UInt16> {t} sm (I64Const <typ.Int> [off/2]) mem)
(I64Load8S [off] sm:(MakeSlice {t} _ _ _) mem) && t.Elem().Size() == 1 =>
	(ArrayGet <typ.Int8> {t} sm (I64Const <typ.Int> [off]) mem)
(I64Load8U [off] sm:(MakeSlice {t} _ _ _) mem) && t.Elem().Size() == 1 =>
	(ArrayGet <typ.UInt8> {t} sm (I64Const <typ.Int> [off]) mem)

// Variable-offset loads (mirror of variable-offset stores).
(I64Load [off] (I64Add sm:(MakeSlice {t} _ _ _) (I64Shl idx (I64Const [k]))) mem)
	&& off == 0 && t.Elem().Size() == 8 && k == 3 =>
	(ArrayGet <typ.Int64> {t} sm idx mem)
(I64Load32S [off] (I64Add sm:(MakeSlice {t} _ _ _) (I64Shl idx (I64Const [k]))) mem)
	&& off == 0 && t.Elem().Size() == 4 && k == 2 =>
	(ArrayGet <typ.Int32> {t} sm idx mem)
(I64Load32U [off] (I64Add sm:(MakeSlice {t} _ _ _) (I64Shl idx (I64Const [k]))) mem)
	&& off == 0 && t.Elem().Size() == 4 && k == 2 =>
	(ArrayGet <typ.UInt32> {t} sm idx mem)
(I64Load16S [off] (I64Add sm:(MakeSlice {t} _ _ _) (I64Shl idx (I64Const [k]))) mem)
	&& off == 0 && t.Elem().Size() == 2 && k == 1 =>
	(ArrayGet <typ.Int16> {t} sm idx mem)
(I64Load16U [off] (I64Add sm:(MakeSlice {t} _ _ _) (I64Shl idx (I64Const [k]))) mem)
	&& off == 0 && t.Elem().Size() == 2 && k == 1 =>
	(ArrayGet <typ.UInt16> {t} sm idx mem)
(I64Load8S [off] (I64Add sm:(MakeSlice {t} _ _ _) idx) mem)
	&& off == 0 && t.Elem().Size() == 1 =>
	(ArrayGet <typ.Int8> {t} sm idx mem)
(I64Load8U [off] (I64Add sm:(MakeSlice {t} _ _ _) idx) mem)
	&& off == 0 && t.Elem().Size() == 1 =>
	(ArrayGet <typ.UInt8> {t} sm idx mem)

// M3 Stage E phase 3: sub-slice element access. Same shape as MakeSlice
// rules — SubSlice produces an anyref to a fresh deep-copied backing,
// indexed identically to a make-slice backing.

(I64Store [off] sm:(SubSlice {t} _ _ _ _ _) val mem) && t.Elem().Size() == 8 =>
	(ArraySet {t} sm (I64Const <typ.Int> [off/8]) val mem)
(I64Store32 [off] sm:(SubSlice {t} _ _ _ _ _) val mem) && t.Elem().Size() == 4 =>
	(ArraySet {t} sm (I64Const <typ.Int> [off/4]) val mem)
(I64Store16 [off] sm:(SubSlice {t} _ _ _ _ _) val mem) && t.Elem().Size() == 2 =>
	(ArraySet {t} sm (I64Const <typ.Int> [off/2]) val mem)
(I64Store8 [off] sm:(SubSlice {t} _ _ _ _ _) val mem) && t.Elem().Size() == 1 =>
	(ArraySet {t} sm (I64Const <typ.Int> [off]) val mem)

(I64Store [off] (I64Add sm:(SubSlice {t} _ _ _ _ _) (I64Shl idx (I64Const [k]))) val mem)
	&& off == 0 && t.Elem().Size() == 8 && k == 3 =>
	(ArraySet {t} sm idx val mem)
(I64Store32 [off] (I64Add sm:(SubSlice {t} _ _ _ _ _) (I64Shl idx (I64Const [k]))) val mem)
	&& off == 0 && t.Elem().Size() == 4 && k == 2 =>
	(ArraySet {t} sm idx val mem)
(I64Store16 [off] (I64Add sm:(SubSlice {t} _ _ _ _ _) (I64Shl idx (I64Const [k]))) val mem)
	&& off == 0 && t.Elem().Size() == 2 && k == 1 =>
	(ArraySet {t} sm idx val mem)
(I64Store8 [off] (I64Add sm:(SubSlice {t} _ _ _ _ _) idx) val mem)
	&& off == 0 && t.Elem().Size() == 1 =>
	(ArraySet {t} sm idx val mem)

(I64Load [off] sm:(SubSlice {t} _ _ _ _ _) mem) && t.Elem().Size() == 8 =>
	(ArrayGet <typ.Int64> {t} sm (I64Const <typ.Int> [off/8]) mem)
(I64Load32S [off] sm:(SubSlice {t} _ _ _ _ _) mem) && t.Elem().Size() == 4 =>
	(ArrayGet <typ.Int32> {t} sm (I64Const <typ.Int> [off/4]) mem)
(I64Load32U [off] sm:(SubSlice {t} _ _ _ _ _) mem) && t.Elem().Size() == 4 =>
	(ArrayGet <typ.UInt32> {t} sm (I64Const <typ.Int> [off/4]) mem)
(I64Load16S [off] sm:(SubSlice {t} _ _ _ _ _) mem) && t.Elem().Size() == 2 =>
	(ArrayGet <typ.Int16> {t} sm (I64Const <typ.Int> [off/2]) mem)
(I64Load16U [off] sm:(SubSlice {t} _ _ _ _ _) mem) && t.Elem().Size() == 2 =>
	(ArrayGet <typ.UInt16> {t} sm (I64Const <typ.Int> [off/2]) mem)
(I64Load8S [off] sm:(SubSlice {t} _ _ _ _ _) mem) && t.Elem().Size() == 1 =>
	(ArrayGet <typ.Int8> {t} sm (I64Const <typ.Int> [off]) mem)
(I64Load8U [off] sm:(SubSlice {t} _ _ _ _ _) mem) && t.Elem().Size() == 1 =>
	(ArrayGet <typ.UInt8> {t} sm (I64Const <typ.Int> [off]) mem)

(I64Load [off] (I64Add sm:(SubSlice {t} _ _ _ _ _) (I64Shl idx (I64Const [k]))) mem)
	&& off == 0 && t.Elem().Size() == 8 && k == 3 =>
	(ArrayGet <typ.Int64> {t} sm idx mem)
(I64Load32S [off] (I64Add sm:(SubSlice {t} _ _ _ _ _) (I64Shl idx (I64Const [k]))) mem)
	&& off == 0 && t.Elem().Size() == 4 && k == 2 =>
	(ArrayGet <typ.Int32> {t} sm idx mem)
(I64Load32U [off] (I64Add sm:(SubSlice {t} _ _ _ _ _) (I64Shl idx (I64Const [k]))) mem)
	&& off == 0 && t.Elem().Size() == 4 && k == 2 =>
	(ArrayGet <typ.UInt32> {t} sm idx mem)
(I64Load16S [off] (I64Add sm:(SubSlice {t} _ _ _ _ _) (I64Shl idx (I64Const [k]))) mem)
	&& off == 0 && t.Elem().Size() == 2 && k == 1 =>
	(ArrayGet <typ.Int16> {t} sm idx mem)
(I64Load16U [off] (I64Add sm:(SubSlice {t} _ _ _ _ _) (I64Shl idx (I64Const [k]))) mem)
	&& off == 0 && t.Elem().Size() == 2 && k == 1 =>
	(ArrayGet <typ.UInt16> {t} sm idx mem)
(I64Load8S [off] (I64Add sm:(SubSlice {t} _ _ _ _ _) idx) mem)
	&& off == 0 && t.Elem().Size() == 1 =>
	(ArrayGet <typ.Int8> {t} sm idx mem)
(I64Load8U [off] (I64Add sm:(SubSlice {t} _ _ _ _ _) idx) mem)
	&& off == 0 && t.Elem().Size() == 1 =>
	(ArrayGet <typ.UInt8> {t} sm idx mem)

// M3 Stage E phase 2.D: ref-backed slice element access on a slice
// parameter. The slice's data pointer arrives as an OpArgIntReg whose
// per-value local is anyref (because the wasm signature's matching
// field is WasmAnyref — see flatPrimitiveFields). The index/store
// rules pattern-match the (I64Add OpArgIntReg ...) shape and lower
// to array.set / array.get on the wasmgc backing.
//
// Wasm3SliceArgElemType(base) walks the function's WasmType +
// declared param list to recover the slice's *types.Type — present
// only when base is the data field of a TSLICE parameter. The
// helper returns nil for non-slice OpArgs (which fall through to
// the standard linear-memory load/store rules).

// Constant-offset stores via slice-arg ptr.
(I64Store [off] base val mem) && Wasm3SliceArgElemType(base) != nil && Wasm3SliceArgElemType(base).Size() == 8 =>
	(ArraySet {types.NewSlice(Wasm3SliceArgElemType(base))} base (I64Const <typ.Int> [off/8]) val mem)
(I64Store32 [off] base val mem) && Wasm3SliceArgElemType(base) != nil && Wasm3SliceArgElemType(base).Size() == 4 =>
	(ArraySet {types.NewSlice(Wasm3SliceArgElemType(base))} base (I64Const <typ.Int> [off/4]) val mem)
(I64Store16 [off] base val mem) && Wasm3SliceArgElemType(base) != nil && Wasm3SliceArgElemType(base).Size() == 2 =>
	(ArraySet {types.NewSlice(Wasm3SliceArgElemType(base))} base (I64Const <typ.Int> [off/2]) val mem)
(I64Store8 [off] base val mem) && Wasm3SliceArgElemType(base) != nil && Wasm3SliceArgElemType(base).Size() == 1 =>
	(ArraySet {types.NewSlice(Wasm3SliceArgElemType(base))} base (I64Const <typ.Int> [off]) val mem)

// Variable-offset stores via slice-arg ptr.
(I64Store [off] (I64Add base (I64Shl idx (I64Const [k]))) val mem)
	&& off == 0 && k == 3 && Wasm3SliceArgElemType(base) != nil && Wasm3SliceArgElemType(base).Size() == 8 =>
	(ArraySet {types.NewSlice(Wasm3SliceArgElemType(base))} base idx val mem)
(I64Store32 [off] (I64Add base (I64Shl idx (I64Const [k]))) val mem)
	&& off == 0 && k == 2 && Wasm3SliceArgElemType(base) != nil && Wasm3SliceArgElemType(base).Size() == 4 =>
	(ArraySet {types.NewSlice(Wasm3SliceArgElemType(base))} base idx val mem)
(I64Store16 [off] (I64Add base (I64Shl idx (I64Const [k]))) val mem)
	&& off == 0 && k == 1 && Wasm3SliceArgElemType(base) != nil && Wasm3SliceArgElemType(base).Size() == 2 =>
	(ArraySet {types.NewSlice(Wasm3SliceArgElemType(base))} base idx val mem)
(I64Store8 [off] (I64Add base idx) val mem)
	&& off == 0 && Wasm3SliceArgElemType(base) != nil && Wasm3SliceArgElemType(base).Size() == 1 =>
	(ArraySet {types.NewSlice(Wasm3SliceArgElemType(base))} base idx val mem)

// Constant-offset loads via slice-arg ptr.
(I64Load [off] base mem) && Wasm3SliceArgElemType(base) != nil && Wasm3SliceArgElemType(base).Size() == 8 =>
	(ArrayGet <typ.Int64> {types.NewSlice(Wasm3SliceArgElemType(base))} base (I64Const <typ.Int> [off/8]) mem)
(I64Load32S [off] base mem) && Wasm3SliceArgElemType(base) != nil && Wasm3SliceArgElemType(base).Size() == 4 =>
	(ArrayGet <typ.Int32> {types.NewSlice(Wasm3SliceArgElemType(base))} base (I64Const <typ.Int> [off/4]) mem)
(I64Load32U [off] base mem) && Wasm3SliceArgElemType(base) != nil && Wasm3SliceArgElemType(base).Size() == 4 =>
	(ArrayGet <typ.UInt32> {types.NewSlice(Wasm3SliceArgElemType(base))} base (I64Const <typ.Int> [off/4]) mem)
(I64Load16S [off] base mem) && Wasm3SliceArgElemType(base) != nil && Wasm3SliceArgElemType(base).Size() == 2 =>
	(ArrayGet <typ.Int16> {types.NewSlice(Wasm3SliceArgElemType(base))} base (I64Const <typ.Int> [off/2]) mem)
(I64Load16U [off] base mem) && Wasm3SliceArgElemType(base) != nil && Wasm3SliceArgElemType(base).Size() == 2 =>
	(ArrayGet <typ.UInt16> {types.NewSlice(Wasm3SliceArgElemType(base))} base (I64Const <typ.Int> [off/2]) mem)
(I64Load8S [off] base mem) && Wasm3SliceArgElemType(base) != nil && Wasm3SliceArgElemType(base).Size() == 1 =>
	(ArrayGet <typ.Int8> {types.NewSlice(Wasm3SliceArgElemType(base))} base (I64Const <typ.Int> [off]) mem)
(I64Load8U [off] base mem) && Wasm3SliceArgElemType(base) != nil && Wasm3SliceArgElemType(base).Size() == 1 =>
	(ArrayGet <typ.UInt8> {types.NewSlice(Wasm3SliceArgElemType(base))} base (I64Const <typ.Int> [off]) mem)

// Variable-offset loads via slice-arg ptr.
(I64Load [off] (I64Add base (I64Shl idx (I64Const [k]))) mem)
	&& off == 0 && k == 3 && Wasm3SliceArgElemType(base) != nil && Wasm3SliceArgElemType(base).Size() == 8 =>
	(ArrayGet <typ.Int64> {types.NewSlice(Wasm3SliceArgElemType(base))} base idx mem)
(I64Load32S [off] (I64Add base (I64Shl idx (I64Const [k]))) mem)
	&& off == 0 && k == 2 && Wasm3SliceArgElemType(base) != nil && Wasm3SliceArgElemType(base).Size() == 4 =>
	(ArrayGet <typ.Int32> {types.NewSlice(Wasm3SliceArgElemType(base))} base idx mem)
(I64Load32U [off] (I64Add base (I64Shl idx (I64Const [k]))) mem)
	&& off == 0 && k == 2 && Wasm3SliceArgElemType(base) != nil && Wasm3SliceArgElemType(base).Size() == 4 =>
	(ArrayGet <typ.UInt32> {types.NewSlice(Wasm3SliceArgElemType(base))} base idx mem)
(I64Load16S [off] (I64Add base (I64Shl idx (I64Const [k]))) mem)
	&& off == 0 && k == 1 && Wasm3SliceArgElemType(base) != nil && Wasm3SliceArgElemType(base).Size() == 2 =>
	(ArrayGet <typ.Int16> {types.NewSlice(Wasm3SliceArgElemType(base))} base idx mem)
(I64Load16U [off] (I64Add base (I64Shl idx (I64Const [k]))) mem)
	&& off == 0 && k == 1 && Wasm3SliceArgElemType(base) != nil && Wasm3SliceArgElemType(base).Size() == 2 =>
	(ArrayGet <typ.UInt16> {types.NewSlice(Wasm3SliceArgElemType(base))} base idx mem)
(I64Load8S [off] (I64Add base idx) mem)
	&& off == 0 && Wasm3SliceArgElemType(base) != nil && Wasm3SliceArgElemType(base).Size() == 1 =>
	(ArrayGet <typ.Int8> {types.NewSlice(Wasm3SliceArgElemType(base))} base idx mem)
(I64Load8U [off] (I64Add base idx) mem)
	&& off == 0 && Wasm3SliceArgElemType(base) != nil && Wasm3SliceArgElemType(base).Size() == 1 =>
	(ArrayGet <typ.UInt8> {types.NewSlice(Wasm3SliceArgElemType(base))} base idx mem)

// Slice-of-string element-field writes/reads via MakeSlice base
// (the local-created slice case — `make([]string, n)` then
// `s[i] = "hello"`). Same wasmgc-backing stride 2 model as the
// slice-arg rules below; just a different base shape to match.
//
// Constant-offset accesses (e.g. tmp[k] = ... with k a compile-
// time constant) fold the per-element byte offset (k * 16) plus
// the field offset (0 = data, 8 = len) into a single I64Load /
// I64Store immediate `off`. Any off that's a multiple of 8 maps
// to wasmgc array index off/8 on the (array i64) backing.
(I64Store [off] sm:(MakeSlice {t} _ _ _) val mem)
	&& off%8 == 0 && t.Elem().IsString() =>
	(ArraySet {t} sm (I64Const <typ.Int> [off/8]) val mem)
(I64Load [off] sm:(MakeSlice {t} _ _ _) mem)
	&& off%8 == 0 && t.Elem().IsString() =>
	(ArrayGet <typ.Int64> {t} sm (I64Const <typ.Int> [off/8]) mem)

// Variable-index field accesses (xs[i] for runtime i, byte
// addressing pattern `base + (i << 4) + off`):
(I64Store [off] (I64Add sm:(MakeSlice {t} _ _ _) (I64Shl idx (I64Const [k]))) val mem)
	&& off == 0 && k == 4 && t.Elem().IsString() =>
	(ArraySet {t} sm (I64Shl idx (I64Const <typ.Int> [1])) val mem)
(I64Store [off] (I64Add sm:(MakeSlice {t} _ _ _) (I64Shl idx (I64Const [k]))) val mem)
	&& off == 8 && k == 4 && t.Elem().IsString() =>
	(ArraySet {t} sm
		(I64Or (I64Shl idx (I64Const <typ.Int> [1])) (I64Const <typ.Int> [1])) val mem)
(I64Load [off] (I64Add sm:(MakeSlice {t} _ _ _) (I64Shl idx (I64Const [k]))) mem)
	&& off == 0 && k == 4 && t.Elem().IsString() =>
	(ArrayGet <typ.Int64> {t} sm (I64Shl idx (I64Const <typ.Int> [1])) mem)
(I64Load [off] (I64Add sm:(MakeSlice {t} _ _ _) (I64Shl idx (I64Const [k]))) mem)
	&& off == 8 && k == 4 && t.Elem().IsString() =>
	(ArrayGet <typ.Int64> {t} sm
		(I64Or (I64Shl idx (I64Const <typ.Int> [1])) (I64Const <typ.Int> [1])) mem)

// Slice-of-string element-field reads. A `[]string` slice's wasmgc
// backing is (array i64) with stride 2: each Go-level string takes
// two i64 slots (data ptr at slot 2i, len at slot 2i+1). The body
// emits the linear-memory pattern `(I64Load [off] (I64Add base
// (I64Shl idx (I64Const [4]))))` (16-byte stride byte addressing)
// — these rules rewrite to the corresponding `array.get_u` on the
// wasmgc backing.

// xs[i].data: byte offset 0, wasmgc index = i << 1.
(I64Load [off] (I64Add base (I64Shl idx (I64Const [k]))) mem)
	&& off == 0 && k == 4 && Wasm3SliceArgElemType(base) != nil && Wasm3SliceArgElemType(base).IsString() =>
	(ArrayGet <typ.Int64> {types.NewSlice(Wasm3SliceArgElemType(base))} base
		(I64Shl idx (I64Const <typ.Int> [1])) mem)
// xs[i].len: byte offset 8, wasmgc index = (i << 1) | 1.
(I64Load [off] (I64Add base (I64Shl idx (I64Const [k]))) mem)
	&& off == 8 && k == 4 && Wasm3SliceArgElemType(base) != nil && Wasm3SliceArgElemType(base).IsString() =>
	(ArrayGet <typ.Int64> {types.NewSlice(Wasm3SliceArgElemType(base))} base
		(I64Or (I64Shl idx (I64Const <typ.Int> [1])) (I64Const <typ.Int> [1])) mem)
// Constant-index field reads (xs[k].field for compile-time k):
// the byte offset folds to k*16 + field_off, and wasmgc index =
// off/8 on the (array i64) backing.
(I64Load [off] base mem)
	&& off%8 == 0 && Wasm3SliceArgElemType(base) != nil && Wasm3SliceArgElemType(base).IsString() =>
	(ArrayGet <typ.Int64> {types.NewSlice(Wasm3SliceArgElemType(base))} base
		(I64Const <typ.Int> [off/8]) mem)

// Slice-of-string element-field writes (mirror of the reads).
// xs[i] = s decomposes into two i64.stores at off=0 (data) and
// off=8 (len); rewrite each to `array.set` on the (array i64)
// backing at the matching i*2 + j offset.
(I64Store [off] (I64Add base (I64Shl idx (I64Const [k]))) val mem)
	&& off == 0 && k == 4 && Wasm3SliceArgElemType(base) != nil && Wasm3SliceArgElemType(base).IsString() =>
	(ArraySet {types.NewSlice(Wasm3SliceArgElemType(base))} base
		(I64Shl idx (I64Const <typ.Int> [1])) val mem)
(I64Store [off] (I64Add base (I64Shl idx (I64Const [k]))) val mem)
	&& off == 8 && k == 4 && Wasm3SliceArgElemType(base) != nil && Wasm3SliceArgElemType(base).IsString() =>
	(ArraySet {types.NewSlice(Wasm3SliceArgElemType(base))} base
		(I64Or (I64Shl idx (I64Const <typ.Int> [1])) (I64Const <typ.Int> [1])) val mem)
(I64Store [off] base val mem)
	&& off%8 == 0 && Wasm3SliceArgElemType(base) != nil && Wasm3SliceArgElemType(base).IsString() =>
	(ArraySet {types.NewSlice(Wasm3SliceArgElemType(base))} base
		(I64Const <typ.Int> [off/8]) val mem)

// transforming readonly globals into constants
(I64Load [off] (LoweredAddr {sym} [off2] (SB)) _) && symIsRO(sym) && isU32Bit(off+int64(off2)) => (I64Const [int64(read64(sym, off+int64(off2), config.ctxt.Arch.ByteOrder))])
(I64Load32U [off] (LoweredAddr {sym} [off2] (SB)) _) && symIsRO(sym) && isU32Bit(off+int64(off2)) => (I64Const [int64(read32(sym, off+int64(off2), config.ctxt.Arch.ByteOrder))])
(I64Load16U [off] (LoweredAddr {sym} [off2] (SB)) _) && symIsRO(sym) && isU32Bit(off+int64(off2)) => (I64Const [int64(read16(sym, off+int64(off2), config.ctxt.Arch.ByteOrder))])
(I64Load8U [off] (LoweredAddr {sym} [off2] (SB)) _) && symIsRO(sym) && isU32Bit(off+int64(off2)) => (I64Const [int64(read8(sym, off+int64(off2)))])
(I64Load32S [off] (LoweredAddr {sym} [off2] (SB)) _) && symIsRO(sym) && isU32Bit(off+int64(off2)) => (I64Const [int64(int32(read32(sym, off+int64(off2), config.ctxt.Arch.ByteOrder)))])
(I64Load16S [off] (LoweredAddr {sym} [off2] (SB)) _) && symIsRO(sym) && isU32Bit(off+int64(off2)) => (I64Const [int64(int16(read16(sym, off+int64(off2), config.ctxt.Arch.ByteOrder)))])
(I64Load8S [off] (LoweredAddr {sym} [off2] (SB)) _) && symIsRO(sym) && isU32Bit(off+int64(off2)) => (I64Const [int64(int8(read8(sym, off+int64(off2))))])

// Fat-pointer Piece 3 (doc/wasm3-fat-pointers-design.md): rebasing
// and load/store through a InteriorPtr value. The NilCheck-strip
// rule for InteriorPtr lives in the NilCheck cluster above so it
// fires before the generic LoweredNilCheck fallback.
//
// (AddPtr (InteriorPtr {t} c off) i) folds the additional
// offset into the fat pointer's index field instead of trying to
// add an i64 to an anyref-typed wasmgc ref (which has no
// instruction encoding). Until Piece 4 adds the helper migration,
// only the runtime.wasm3InteriorPtr intrinsic emits these ops, so
// the rule fires only on code paths that opt in explicitly.
(I64Add iptr:(InteriorPtr {t} c off) extra) =>
	(InteriorPtr {t} c (I64Add off extra))

// Loads through a fat pointer rewrite to OpLoadInterior with
// the same Aux. The wasm3 obj backend reads the elem size from the
// container *types.Type and emits the appropriate
// array.get_u/get_s/get plus i64-extension. The `off` parameter on
// the linear-memory load must be zero — a non-zero linear-memory
// offset on a fat pointer is meaningless (the fat pointer's own
// offset field is what addresses sub-element bytes).
(I64Load8U  [off] iptr:(InteriorPtr {t} _ _) mem) && off == 0 => (LoadInterior <typ.UInt8>  {t} iptr mem)
(I64Load8S  [off] iptr:(InteriorPtr {t} _ _) mem) && off == 0 => (LoadInterior <typ.Int8>   {t} iptr mem)
(I64Load16U [off] iptr:(InteriorPtr {t} _ _) mem) && off == 0 => (LoadInterior <typ.UInt16> {t} iptr mem)
(I64Load16S [off] iptr:(InteriorPtr {t} _ _) mem) && off == 0 => (LoadInterior <typ.Int16>  {t} iptr mem)
(I64Load32U [off] iptr:(InteriorPtr {t} _ _) mem) && off == 0 => (LoadInterior <typ.UInt32> {t} iptr mem)
(I64Load32S [off] iptr:(InteriorPtr {t} _ _) mem) && off == 0 => (LoadInterior <typ.Int32>  {t} iptr mem)
// Reference-element slices ([]*T): a pointer element is size 8 so its load
// lowers to I64Load too, but the result is a WasmGC ref (anyref local), not
// an i64 — give LoadInterior the pointer result type so its per-value local
// is anyref and array.get's typed ref lands there directly (no i64-extend).
// Must precede the plain I64Load rule below.
(I64Load    [off] iptr:(InteriorPtr {t} _ _) mem) && off == 0 &&  (t.Elem().IsPtr() || t.Elem().IsUnsafePtr()) => (LoadInterior <t.Elem()>   {t} iptr mem)
(I64Load    [off] iptr:(InteriorPtr {t} _ _) mem) && off == 0 && !(t.Elem().IsPtr() || t.Elem().IsUnsafePtr()) => (LoadInterior <typ.Int64>  {t} iptr mem)
// Float-element slices: the load lowers to F64Load/F32Load (not I64Load),
// so they need their own InteriorPtr rules. LoadInterior codegen reads the
// float element with array.get and no i64-extension.
(F64Load    [off] iptr:(InteriorPtr {t} _ _) mem) && off == 0 => (LoadInterior <typ.Float64> {t} iptr mem)
(F32Load    [off] iptr:(InteriorPtr {t} _ _) mem) && off == 0 => (LoadInterior <typ.Float32> {t} iptr mem)

// Stores through a fat pointer rewrite to OpStoreInterior.
(I64Store8  [off] iptr:(InteriorPtr {t} _ _) val mem) && off == 0 => (StoreInterior {t} iptr val mem)
(I64Store16 [off] iptr:(InteriorPtr {t} _ _) val mem) && off == 0 => (StoreInterior {t} iptr val mem)
(I64Store32 [off] iptr:(InteriorPtr {t} _ _) val mem) && off == 0 => (StoreInterior {t} iptr val mem)
(I64Store   [off] iptr:(InteriorPtr {t} _ _) val mem) && off == 0 => (StoreInterior {t} iptr val mem)
(F64Store   [off] iptr:(InteriorPtr {t} _ _) val mem) && off == 0 => (StoreInterior {t} iptr val mem)
(F32Store   [off] iptr:(InteriorPtr {t} _ _) val mem) && off == 0 => (StoreInterior {t} iptr val mem)
